# Public deployment
DOMAIN=
SITE_NAME=SiYue Blog
SITE_DESCRIPTION=记录技术实践与持续思考的个人博客

# Database (generate a unique password)
DB_NAME=siyue_blog
DB_USER=siyue
DB_PASSWORD=

# Authentication (each secret must be different and at least 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public profile
AUTHOR_NAME=SiYue
AUTHOR_BIO=专注于构建可靠、清晰且有温度的软件产品。
AUTHOR_EMAIL=
AUTHOR_LOCATION=中国
AUTHOR_GITHUB=
AUTHOR_TWITTER=

# Images and releases (optional; CI may override these)
BACKEND_IMAGE=siyue-blog-backend
FRONTEND_IMAGE=siyue-blog-frontend
RELEASE_TAG=latest

# Local backup retention
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
